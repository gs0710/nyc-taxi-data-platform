# Postgres (data warehouse)
POSTGRES_USER=taxi_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=taxi_dw
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# MinIO (local data lake), used from Phase 4
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=change_me_too
MINIO_ENDPOINT=http://localhost:9000

# General
DATA_DIR=./data
LOG_LEVEL=INFO

# Data lake
LAKE_BUCKET=taxi-lake

# Airflow metadata database (Phase 9)
AIRFLOW_DB_PASSWORD=change_me
AIRFLOW_UID=change_me
AIRFLOW_FERNET_KEY=change_me
AIRFLOW_JWT_SECRET=change_me
AIRFLOW_ADMIN_PASSWORD=change_me
DOCKER_GID=change_me
HOST_PROJECT_DIR=change_me

# AWS S3 (Phase 14, cloud data lake)
AWS_ACCESS_KEY_ID=your_key_id
AWS_SECRET_ACCESS_KEY=your_secret
AWS_REGION=us-east-1
S3_BUCKET=your-bucket-name

# Lake backend: minio (local, default) or s3 (AWS)
LAKE_BACKEND=minio
